rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // User-private data: only the authenticated owner can read/write
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Not: public_programs koleksiyonu ve Keşfet özelliği kaldırıldı.
    // Kural tanımlanmadığı için erişim varsayılan olarak reddedilir; koleksiyondaki
    // eski veriler Firestore'da duruyor, özellik geri gelirse kural yeniden eklenir.
  }
}
