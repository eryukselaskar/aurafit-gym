# AuraFit — Firebase ayarları
#
# Bu dosyayı `.env` olarak kopyalayıp kendi Firebase projenizin değerleriyle
# doldurun. Ayar yoksa uygulama yine çalışır, yalnızca yerel modda: programlar,
# antrenmanlar ve ölçümler cihazda saklanır, bulut eşitlemesi ve Google ile
# giriş devre dışı kalır.
#
# Değerleri nereden alacaksınız:
#   Firebase Console -> Proje ayarları -> Uygulamalarınız -> Web uygulaması
#
# Bu anahtarlar gizli değildir; Firebase web anahtarları istemciyle birlikte
# dağıtılmak üzere tasarlanmıştır. Güvenlik firestore.rules ile sağlanır.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=projeniz.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=projeniz
VITE_FIREBASE_STORAGE_BUCKET=projeniz.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Android'de yerel Google Sign-In için OAuth istemci kimliği (Web tipi).
# Firebase Console -> Authentication -> Sign-in method -> Google -> Web SDK yapılandırması
VITE_GOOGLE_CLIENT_ID=
